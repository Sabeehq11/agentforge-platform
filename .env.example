# Copy to .env (git-ignored). Never commit real values.
# OPENROUTER_API_KEY is the existing Gauntlet key. Do not paste it into chat or a tracked file.
# The other names are operator-supplied. LIVE_ENABLED and PROVIDER_ENABLED in this file are ignored.
# Live switches are not set here. The only opt-in is config/live.local containing the single word live.
OPENROUTER_API_KEY=
AGENTFORGE_BUDGET_SECRET=
AGENTFORGE_BUDGET_TOKEN=
AGENTFORGE_TARGET_ORIGIN=
AGENTFORGE_FIXTURE_USER=
AGENTFORGE_FIXTURE_PASSWORD=
AGENTFORGE_FIXTURE_PID=
AGENTFORGE_CHAT_RESERVE_USD=
